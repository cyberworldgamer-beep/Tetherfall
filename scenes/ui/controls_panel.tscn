[node name="Contract" type="Label" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Aether cores are scattered through the Kessler Belt. Touch them to load up to three, then fly through the SALVAGE GATE to bank the score and buy more time.

Every successful delivery builds your chain multiplier. Impacts, heat, and missed delivery windows break the chain.

Asteroids are anchors: tether to any rock and swing. Momentum is free. Thrust is not."
autowrap_mode = 3

