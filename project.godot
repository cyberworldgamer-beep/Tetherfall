; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TETHERFALL"
config/description="Ride the wreckage. Feed the gate. A zero-gravity tether-swing salvage run."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.0118, 0.0157, 0.03, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Triggers"

[physics]

3d/default_gravity=0.0
3d/default_gravity_vector=Vector3(0, 0, 0)

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.028, 1)
